<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>FM26PlayerExport</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <FM26Path Condition="'$(FM26Path)' == '' and '$(FM26_PATH)' != ''">$(FM26_PATH)</FM26Path>
    <FM26Path Condition="'$(FM26Path)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Football Manager 26</FM26Path>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core"><HintPath>$(FM26Path)\BepInEx\core\BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(FM26Path)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(FM26Path)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(FM26Path)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(FM26Path)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(FM26Path)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIElementsModule"><HintPath>$(FM26Path)\BepInEx\interop\UnityEngine.UIElementsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>$(FM26Path)\BepInEx\interop\Unity.InputSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(FM26Path)\BepInEx\interop\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(FM26Path)\BepInEx\interop\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputForUIModule"><HintPath>$(FM26Path)\BepInEx\interop\UnityEngine.InputForUIModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="ValidateFM26Path" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(FM26Path)\BepInEx\core\BepInEx.Core.dll')" Text="FM26/BepInEx assemblies were not found under '$(FM26Path)'. Build with -p:FM26Path=&quot;FULL_PATH_TO_FOOTBALL_MANAGER_26&quot;." />
  </Target>
</Project>
